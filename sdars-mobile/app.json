{
  "expo": {
    "name": "SDARS Alert",
    "slug": "sdars-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sdars.disasteralert",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SDARS requires GPS access to detect your proximity to real-time disaster zones."
      }
    },
    "android": {
      "package": "com.sdars.disasteralert",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A0E1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow SDARS to detect your location for disaster alerts and tactical routing."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "52208377-b686-4857-9473-7f8b4d78e1b5"
      }
    }
  }
}
