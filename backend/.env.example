# ==============================================================================
# SDARS - Environment Configuration Template (.env.example)
# All values are placeholders. Copy this file to .env and configure real values.
# ==============================================================================

# OpenWeatherMap API key for live meteorological fallback telemetry
OPENWEATHER_API_KEY=your_openweather_api_key_here

# NASA Earthdata / FIRMS API key for active thermal wildfire hotspot detection
NASA_API_KEY=DEMO_KEY

# Sentinel Hub OAuth client ID for multispectral satellite imagery
SENTINEL_HUB_CLIENT_ID=your_sentinel_hub_client_id

# Sentinel Hub OAuth client secret for API authentication
SENTINEL_HUB_CLIENT_SECRET=your_sentinel_hub_client_secret

# Sentinel Hub WMS instance ID for visual map tile layers
SENTINEL_INSTANCE_ID=your_sentinel_instance_id

# Sentinel Hub standalone API key for imagery processing service
SENTINEL_API_KEY=your_sentinel_api_key

# Planet Labs API key for high-resolution daily satellite imagery
PLANET_API_KEY=your_planet_api_key

# Planet Labs account user identifier
PLANET_USER_ID=your_planet_user_id

# Outgoing SMTP server hostname for automated disaster warning emails
SMTP_SERVER=smtp.gmail.com

# SMTP server port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Sender email address used to dispatch alert notifications
SMTP_EMAIL=your_email@gmail.com

# Sender email app-specific password for SMTP authentication
SMTP_PASSWORD=your_smtp_app_password

# Default emergency recipient email address for system alerts
ALERT_EMAIL_TO=emergency_recipient@example.com

# Default emergency recipient mobile phone number (E.164 format)
ALERT_PHONE=+1234567890

# Twilio Account SID for emergency SMS alerts
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# Twilio Auth Token for SMS gateway authentication
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio registered sender phone number
TWILIO_PHONE_NUMBER=+1234567890

# Telegram Bot API token for dispatching warning notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Telegram target chat or channel ID for receiving alert dispatches
TELEGRAM_CHAT_ID=your_telegram_chat_id

# SQLAlchemy database connection URL (defaults to canonical root SQLite DB if unset)
DATABASE_URL=sqlite:///./sdars_database.db

# Database name identifier
DATABASE_NAME=sdars_db

# Network host address the API server binds to (127.0.0.1 for local, 0.0.0.0 for container)
API_HOST=127.0.0.1

# Network port on which the FastAPI application listens
API_PORT=8000

# Cloud platform deployment port override (e.g. Render / Heroku)
PORT=8000

# Toggle verbose console logging and development features (true / false)
DEBUG_MODE=false

# Enable demo simulation mode with static test verification code 123456 (true / false)
DEMO_MODE=false

# Force unbuffered standard output streams for live cloud logging
PYTHONUNBUFFERED=1

