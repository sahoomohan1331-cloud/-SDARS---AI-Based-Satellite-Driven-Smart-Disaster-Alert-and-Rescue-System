# ============================
# SDARS - .gitignore
# ============================

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ---- Virtual Environments ----
venv/
env/
.env
*.env
.venv/
.venv*/
.venv-pinned-check
.venv-pinned-check/

# ---- Secrets & API Keys ----
backend/.env
.env.local
.env.production
secrets.py
config_secret.py

# ---- Database Files & Local Archives ----
*.db
*.sqlite
*.sqlite3
archive_local/

# ---- Machine Learning Model Binaries ----
*.joblib
*.pkl
*.h5
*.pt
*.onnx

# ---- IDE & Editor ----
.vscode/
.idea/
*.suo
*.user
*.workspace

# ---- OS Files ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Logs ----
*.log
logs/

# ---- Jupyter Notebooks (checkpoints) ----
.ipynb_checkpoints/

# ---- Node Modules (if any) ----
node_modules/
npm-debug.log

# ---- Temporary Files ----
*.tmp
*.temp
*.bak
*.swp
~$*
scratch/
r*.json
